
<main id="main" class="main">

    <div class="pagetitle">
        <h1>All Survey</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item">Survey</li>
                <li class="breadcrumb-item active">All Survey</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->

    <section>
        <div class="container mt-4">
            
            <div class="row">
                <div class="table-responsive-md mt-2">
         <div class="d-flex justify-content-between align-items-center">
            <h4 class="mt-3 mb-3">All Survey</h4>
        </div>
                    <h1></h1>
                    <table class="w-100 table table-bordered" id="dataTable">
                        <thead>
                            <tr>
                                
                                 <th scope="col">No.</th>
                                 <th data-type="date" data-format="YYYY/DD/MM">Added Date</th>
                                <th scope="col">Title</th>
                                <th scope="col">Class</th>
                                <th scope="col">Subject</th>
                                <th scope="col">Action</th>
                            
                            </tr>
                        </thead>
                        <tbody>
                            {{#each materials}}
                            <tr>
                                <td>{{incremented @index}}</td>
                                
                                <th>{{formatDate this.createdAt}}</th>
                                <td>{{this.assessmentTitle}}</td>
                                <td>{{this.classname}}</td>
                                <td>{{this.subject}}</td>
                                

                              

                                </td>

                                <td>
                                    <div class="d-flex gap-2">
                                        <a href="/admin/assessment-show/{{this._id}}"
                                            class="btn btn-dark btn-sm">view</a>
                                            <a href="/admin/survey-list/{{this._id}}"
                                            class="btn btn-dark btn-sm">View Results</a>
                                        <a href="/admin/delete-survey/{{this._id}}" class="btn btn-danger btn-sm">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </section>
</main>