<main id="main" class="main">

    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mt-3 mb-3">Manage Your Exams</h4>
        </div>
        <div class="card">
            <div class="card-body">



                <h5 class="card-title">All Exam</h5>



                <div class="table-responsive">
                    <!-- Table with stripped rows -->
                    <table class="table table-bordered datatable">
                        <thead>
                            <tr>
                                <th>No.</th>
                                <th data-type="date" data-format="YYYY/DD/MM">Added Date</th>
                                <th data-type="date" data-format="YYYY/DD/MM">Exam Date</th>
                                <th>class</th>
                                <th>subject</th>
                                <th>Exam Details</th>
                                <th>Manage</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each exams}}
                            <tr>
                                <td>{{incremented @index}}</td>
                                <td>{{formatDate this.createdAt}}</td>
                                <td>{{formatDate this.examdate}}</td>
                                <td>{{this.classname}}</td>
                                <td>{{this.subject}}</td>
                                <td>{{this.no}}</td>
                                 <td>
                                    <a href="/admin/delete-exam/{{this._id}}" class="btn btn-danger btn-sm">Delete</a>

                                </td>

                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
                <!-- End Table with stripped rows -->
            </div>
        </div>
    </div>
    </div>


    <script>
        function deleteMaterial(id, wname) {
            Swal.fire({
                title: `Are you sure you want to delete "${wname}"?`,
                text: '',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#33ff68',
                cancelButtonColor: '#d29eee',
                confirmButtonText: 'Yes!',
                cancelButtonText: 'No'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Redirect to the delete route if confirmed
                    window.location.href = `/builder/delete-material/${id}`;
                }
            });
        }
    </script>