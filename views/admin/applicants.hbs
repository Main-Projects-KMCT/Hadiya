

<main id="main" class="main">

    <div class="pagetitle">
        <h1>Applicants</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item">Jobs</li>
                <li class="breadcrumb-item active">Applicants</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->

    <section>
        <div class="container mt-4">
            
            <div class="row">
                <div class="table-responsive-md mt-2">
         <div class="d-flex justify-content-between align-items-center">
            <h4 class="mt-3 mb-3">All jobs</h4>
          
        </div>
                    <h1>{{job.title}}</h1>
                    <table class="table responsive border table-bordered">
                        <thead class="table-dark">
                            <tr class="align-middle">
                                <th scope="col">No.</th>
                                <th scope="col">Posting Date</th>
                                <th scope="col">Name</th>
                                <th scope="col">Email</th>
                                <th scope="col">phone</th>
                                <th scope="col">qualification</th>
                                <th scope="col">Experience</th>
                                <th scope="col">Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                             {{#each applicants}}
    <tr class="align-middle">
        <th scope="row">{{incremented @index}}</th>
         <td>{{formatDate this.appliedAt}}</td>
        <td>{{this.fullName}}</td>
        <td>{{this.email}}</td>
        <td>{{this.phone}}</td>
        <td>{{this.qualification}}</td>
        <td>{{this.experiance}}</td>
        <td>
            
            <a href="/images/resume/{{this._id}}.pdf" class="mt-2 btn btn-dark btn-sm">
            View Resume
        </a>
            
        
                                </td>
    </tr>
    {{/each}}
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </section>
</main>