]
<main id="main" class="main">

    <div class="pagetitle">
        <h1>Manage Notifications</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item">Notifications</li>
                <li class="breadcrumb-item active">All-Notifications</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->





    <section class="section">
        <div class="form-group border">
             <h3>Add New Job</h3>
<form action="/admin/jobs/add" method="POST">
    <input type="text" name="title" placeholder="Job Title" required />
    <label>Description</label>
    <textarea name="description" id="" cols="4"></textarea>
    <input type="text" name="salary" placeholder="salary" required />
    <button type="submit">Add Job</button>
</form>
        </div>
      

        <div class="row">

            <div class="col-lg-12">

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">All Notifications</h5>
                        <div class="table-responsive">
                            <table class="table" id="table">
    <tr>
        <th>Title</th>
        <th>Company</th>
        <th>Location</th>
        <th>Actions</th>
    </tr>
    {{#each jobs}}
    <tr>
        <td>{{this.title}}</td>
        <td>{{this.company}}</td>
        <td>{{this.location}}</td>
        <td>
            <form action="/admin/jobs/delete/{{this._id}}" method="POST">
                <button type="submit">Delete</button>
            </form>
            <a href="/admin/jobs/applicants/{{this._id}}">View Applicants</a>
        </td>
    </tr>
    {{/each}}
</table>

                            </table>
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </section>

</main><!-- End #main -->