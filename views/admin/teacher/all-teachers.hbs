<main id="main" class="main">

    <div class="pagetitle">
        <h1>Manage Teachers</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item">Teacher</li>
                <li class="breadcrumb-item active">All-Teacher</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-lg-12">

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">All Teachers</h5>
                        <div class="table-responsive">
                            <table class="table datatable">
                                <thead>
                                    <tr>
                                        <th>No.</th>
                                        <th data-type="date" data-format="YYYY/DD/MM">Joined Date</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Address</th>
                                        <th>City</th>
                                        <th>Manage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each teachers}}
                                    <tr>
                                        <td>{{incremented @index}}</td>
                                        <td>{{this.date}}</td>
                                        <td>{{this.Name}}</td>
                                        <td>{{this.Email}}</td>
                                        <td>{{this.Phone}}</td>
                                        <td>{{this.Address}}</td>
                                        <td>{{this.City}}</td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                {{#if this.approved}}
                                                <span class="badge bg-success p-2">Approved</span>
                                                {{else if this.rejected}}
                                                <span class="badge bg-danger p-2">Rejected</span>
                                                {{else}}
                                                <form action="/admin/approve-teacher/{{this._id}}" method="POST">
                                                    <button type="submit" class="btn btn-success btn-sm"><i
                                                            class="bi bi-check2"></i></button>
                                                </form>
                                                <form action="/admin/reject-teacher/{{this._id}}" method="POST">
                                                    <button type="submit" class="btn btn-dark btn-sm"><i
                                                            class="bi bi-ban"></i></button>
                                                </form>
                                                {{/if}}
                                           {{#if this.isDisable}}
                                        <td>
                                            <button class="btn btn-secondary btn-sm" disabled>Blocked</button>
                                            <a href="/admin/view-teacher/{{this._id}}" class="btn btn-primary btn-sm" >view</a>
                                        </td>
                                        {{else}}
                                        <td>
                                            <a href="#" class="btn btn-danger btn-sm" data-bs-toggle="modal"
                                                data-bs-target="#blockModal"
                                                onclick="setUserIdToBlock('{{this._id}}')">Block</a>
                                            <a href="/admin/view-teacher/{{this._id}}" class="btn btn-primary btn-sm" >view</a>
                                        </td>
                                        
                                        {{/if}}
                                       
                                            </div>
                                        </td>

                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </section>

    <div class="modal fade" id="blockModal" tabindex="-1" aria-labelledby="blockModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="blockModalLabel">Block Teacher</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <textarea id="blockReason" class="form-control" rows="4"
                    placeholder="Enter reason for blocking..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger" onclick="blockUser()">Block Teacher</button>
            </div>
        </div>
    </div>
</div>

</main><!-- End #main -->
<script>
    let userIdToBlock = null;

    function setUserIdToBlock(userId) {
        userIdToBlock = userId;
    }

</script>
<script>
    function blockUser() {
        const reason = document.getElementById("blockReason").value;

        if (reason.trim() === "") {
            alert("Please enter a reason for blocking.");
            return;
        }

        // Send a request to the server to block the user
        fetch(`/admin/block-teacher/${userIdToBlock}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                reason: reason,
            }),
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Close the modal
                    $('#blockModal').modal('hide');
                    alert('Teacher blocked successfully');
                    // You can also reload the page or update the UI
                    location.reload();
                } else {
                    alert('Failed to block the user');
                }
            })
            .catch(error => {
                console.error('Error blocking user:', error);
            });
    }
</script>
