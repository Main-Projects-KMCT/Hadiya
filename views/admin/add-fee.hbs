<main id="main" class="main">

    <div class="pagetitle">
        <h1>Add Exam Fees</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item">Exam Fees</li>
                <li class="breadcrumb-item active">All-Exam Fees</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->

    <section>
        <div class="container mt-4">
            <div class="row">
                <div class="col-md-6">
                    <form action="/admin/add-fee" enctype="multipart/form-data" method="POST">
                        {{!-- <input type="hidden" name="seat" class="form-control" value="100000"> --}}

                        <label class="form-label" for="exampleInputText">Class</label>
                                 <select class="form-select form-control" name="classname" aria-label="Default select example">
                                    <option selected disabled>Select</option>
                                    {{#each cls}}
                                    <option value="{{this.name}}">{{this.name}}</option>
                                    {{/each}}
                                </select>

                        <label for="">Exam Name</label>
                        <input type="text" name="Name" class="form-control" required>

                        <label for="">Price</label>
                        <input type="text" name="Price" class="form-control" required>

                        <label for="">Description</label>
                        <input type="text" name="Description" class="form-control" required>



                        <button type="submit" class="btn btn-success mt-4">Submit</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
</main>