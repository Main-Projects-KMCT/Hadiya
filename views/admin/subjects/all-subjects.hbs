<main id="main" class="main">

    <div class="pagetitle">
        <h1>Manage Subject</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item">Subject</li>
                <li class="breadcrumb-item active">All-Subject</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-lg-12">

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">All Subject</h5>

<button type="button" class="btn btn-primary mb-4" data-toggle="modal"
                            data-target="#exampleModalCenter">
                            + Add Subject
                        </button>

                        <div class="table-responsive">
                            <!-- Table with stripped rows -->
                            <table class="table datatable">
                                <thead>
                                    <tr>
                                        <th>No.</th>
                                        <th>Name</th>
                                        <th>Teacher</th>
                                        <th>Status</th>
                                        <th>Manage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each subjects}}
                                    <tr>
                                        <td>{{incremented @index}}</td>
                                        <td>{{this.sname}} </td>
                                        <td>
                                        {{#each this.teacherNames}}
                                            {{this}}{{#unless @last}}, {{/unless}}
                                        {{/each}}
                                        </td>
                                        <td >Active</td>
                                      
                                        <td>
                                            <div class="d-flex gap-2">

                                                <form action="/admin/delete-subject/{{this._id}}" method="POST">
                                                    <button type="submit" class="btn btn-danger btn-sm"
                                                        onclick="return confirm('Are You Sure to Delete {{this.sname}} ?')"><i
                                                            class="bi bi-trash"></i></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                        <!-- End Table with stripped rows -->

                    </div>
                </div>

            </div>
        </div>
    </section>

</main><!-- End #main -->

<div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Add New Subject</h5>

            </div>
            <div class="modal-body">
                <form action="/admin/subjects/add-subject" method="post">
                    <div class="col-md-12">
                        <label for="inputName5" class="form-label">Subject Name</label>
                        <input type="text" class="form-control" name="sname" id="inputName5" required>
                    </div>
                    {{!-- <div class="col-md-12">
                        <label for="inputName5" class="form-label">Subject Code</label>
                        <input type="text" class="form-control" name="scode" id="inputName5" required>
                    </div> --}}

                    <div class="col-md-12">
                        <label for="inputName5" class="form-label">Select Teacher</label>
                        <select class="form-control form-control" name="teachers" multiple>
                            {{#each teachers}}
                            <option value="{{this._id}}"> {{this.Name}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="row g-1">
                            <div class="col-lg-6">
                                <label for="current-password" class="form-label mb-8 h6"> Select Department</label>
                            <select class="form-control" name="depcode" id="departmentSelect" required>
                            <option value="">-- Select Department --</option>
                            {{#each deps}}
                            <option value="{{this.depcode}}">{{this.name}}</option>
                            {{/each}}
                        </select>

                            </div>

                            <div class="col-lg-6">
                                <label for="classSelect" class="form-label mb-8 h6">Select Class</label>
                                <select class="form-control" name="classname" id="classSelect" required>
                                    <option value="">-- Select Class --</option>
                                </select>
                            </div>
                        </div>



            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary">Add</button>
            </div>
            </form>

        </div>
    </div>
</div>
<!-- jQuery -->

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>

<!-- Bootstrap JS -->
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const departmentSelect = document.getElementById('departmentSelect');
        const classSelect = document.getElementById('classSelect');

        departmentSelect.addEventListener('change', function () {
            const depcode = this.value;
            console.log(depcode);

            if (depcode) {
                fetch(`/get-classes/${depcode}`)
                    .then(response => response.json())
                    .then(res => {
                        classSelect.innerHTML = '<option value="">-- Select Class --</option>';
                        if (res.success) {
                            res.classes.forEach(cls => {
                                const option = document.createElement('option');
                                option.value = cls.name;
                                option.textContent = cls.name;
                                classSelect.appendChild(option);
                            });
                        }
                    })
                    .catch(error => {
                        alert('Failed to load classes');
                        console.error(error);
                    });
            } else {
                classSelect.innerHTML = '<option value="">-- Select Class --</option>';
            }
        });
    });
</script>


<script>
    let userIdToBlock = null;

    function setUserIdToBlock(userId) {
        userIdToBlock = userId;
    }

</script>
<script>
    function blockUser() {
        const reason = document.getElementById("blockReason").value;

        if (reason.trim() === "") {
            alert("Please enter a reason for blocking.");
            return;
        }

        // Send a request to the server to block the user
        fetch(`/admin/block-user/${userIdToBlock}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                reason: reason,
            }),
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Close the modal
                    $('#blockModal').modal('hide');
                    alert('User blocked successfully');
                    // You can also reload the page or update the UI
                    location.reload();
                } else {
                    alert('Failed to block the user');
                }
            })
            .catch(error => {
                console.error('Error blocking user:', error);
            });
    }
</script>
<script>
$(document).ready(function () {
    $('form[action="/admin/subjects/add-subject"]').on('submit', function (e) {
        e.preventDefault();

        const form = $(this)[0];
        const formData = new FormData(form);

        const teachers = formData.getAll('teachers');

        const subject = {
            sname: formData.get('sname'),
            teachers: teachers,
            depcode: formData.get('depcode'),
            classname: formData.get('classname')
        };

        console.log(subject); // Check if teachers is always array

        $.ajax({
            url: '/admin/subjects/add-subject',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(subject),
            success: function (data) {
                if (data.success) {
                    alert('Subject Added Successfully');
                    location.reload();
                } else {
                    alert('Failed: ' + data.message);
                }
            },
            error: function (err) {
                console.error('Error:', err);
                alert('Something went wrong');
            }
        });
    });
});
</script>

