<main id="main" class="main">

    <div class="pagetitle">
        <h1>Manage Users</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item">Users</li>
                <li class="breadcrumb-item active">view Users</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-lg-12">

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">View Users</h5>



                        
                    <table class="table responsive border table-bordered">
                        <thead class="table-dark">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Address</th>
                                        <th>District</th>
                                        <th>Pincode</th>
                                        <th>Status</th>
                                        <th>Blocked Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                               
                                    <tr>
                                        <td>{{users.Fname}} {{users.Lname}}</td>
                                        <td>{{users.Email}}</td>
                                        <td>{{users.Phone}}</td>
                                        <td>{{users.Address}}</td>
                                        <td>{{users.District}}</td>
                                        <td>{{users.Pincode}}</td>
                                        {{#if users.isDisable}}
                                        <td>
                                            Blocked
                                        </td>
                                        <td>
                                          {{users.reason}}
                                        </td>
                                        {{else}}
                                        <td>
                                           Active
                                        </td>
                                        <td>
                                          {{users.reason}}
                                        </td>
                                        
                                        {{/if}}

                                    </tr>

                                    
                                </tbody>
                            </table>
                        </div>
                        <!-- End Table with stripped rows -->

                    </div>
                </div>

            </div>
        </div>
    </section>

</main><!-- End #main -->

<div class="modal fade" id="blockModal" tabindex="-1" aria-labelledby="blockModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="blockModalLabel">Block User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <textarea id="blockReason" class="form-control" rows="4"
                    placeholder="Enter reason for blocking..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger" onclick="blockUser()">Block User</button>
            </div>
        </div>
    </div>
</div>
<!-- jQuery -->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<!-- Bootstrap JS -->
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>

<script>
    let userIdToBlock = null;

    function setUserIdToBlock(userId) {
        userIdToBlock = userId;
    }

</script>
<script>
    function blockUser() {
        const reason = document.getElementById("blockReason").value;

        if (reason.trim() === "") {
            alert("Please enter a reason for blocking.");
            return;
        }

        // Send a request to the server to block the user
        fetch(`/admin/block-user/${userIdToBlock}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                reason: reason,
            }),
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Close the modal
                    $('#blockModal').modal('hide');
                    alert('User blocked successfully');
                    // You can also reload the page or update the UI
                    location.reload();
                } else {
                    alert('Failed to block the user');
                }
            })
            .catch(error => {
                console.error('Error blocking user:', error);
            });
    }
</script>