<main id="main" class="main">

    <div class="pagetitle">
        <h1>Manage Timetable</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item">Timetable</li>
                <li class="breadcrumb-item active">All-Timetable</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-lg-12">

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">All Timetable  for {{cls}}</h5>
                        <button type="button" class="btn btn-primary mb-4" data-toggle="modal"
                            data-target="#exampleModalCenter">
                            + Add Timetable
                        </button>
                        <div class="table-responsive">
                            <table class="table border table-bordered">
                                <thead>
                                    <tr>
                                        <th>Day</th>

                                        <th>Period 1</th>
                                        <th>Period 2</th>
                                        <th>Period 3</th>
                                        <th>Period 4</th>
                                        <th>Period 5</th>
                                        <th>Period 6</th>
                                        <th>Manage</th>
                                    </tr>
                                </thead>
                                  <tbody>
    {{#each timetables}}
      <tr>
        <td>{{day}}</td>
        <td>
          {{#if periods.[0]}}
            {{periods.[0].teacher}} - {{periods.[0].subject}}
          {{else}}
            -
          {{/if}}
        </td>
        <td>
          {{#if periods.[1]}}
            {{periods.[1].teacher}} - {{periods.[1].subject}}
          {{else}}
            -
          {{/if}}
        </td>
        <td>
          {{#if periods.[2]}}
            {{periods.[2].teacher}} - {{periods.[2].subject}}
          {{else}}
            -
          {{/if}}
        </td>
        <td>
          {{#if periods.[3]}}
            {{periods.[3].teacher}} - {{periods.[3].subject}}
          {{else}}
            -
          {{/if}}
        </td>
        <td>
          {{#if periods.[4]}}
            {{periods.[4].teacher}} - {{periods.[4].subject}}
          {{else}}
            -
          {{/if}}
        </td>
        <td>
          {{#if periods.[5]}}
            {{periods.[5].teacher}} - {{periods.[5].subject}}
          {{else}}
            -
          {{/if}}
        </td>
      </tr>
    {{/each}}
  </tbody>
                            </table>
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </section>

</main><!-- End #main -->


<div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Add New Subject</h5>
            </div>
            <div class="modal-body">
                <form action="/admin/timetables/add-timetable" method="post">
                <input type="hidden" value="{{cls}}" name="class">
                <input type="hidden" value="{{code}}" name="depcode">
  <div class="col-md-12">
    <label>Select Day</label>
    <select class="form-control" name="day">
      <option disabled selected>Select Day</option>
      <option value="Monday">Monday</option>
      <option value="Tuesday">Tuesday</option>
      <option value="Wednesday">Wednesday</option>
      <option value="Thursday">Thursday</option>
      <option value="Friday">Friday</option>
      <option value="Saturday">Saturday</option>
    </select>
  </div>
<div class="row">
  {{#each teachers}}
    {{#if @first}}{{@root.break}}
    <!-- Period 1 -->
    <div class="col-md-12 mt-3">
      <label><b>1st Period</b></label>
      <select class="form-control" name="period1">
        <option disabled selected>Select</option>
        {{#each ../teachers}}
          <option value="{{_id}}|{{subject._id}}">{{Name}} - {{subject.sname}}</option>
        {{/each}}
      </select>
    </div>

    <!-- Period 2 -->
    <div class="col-md-12 mt-3">
      <label><b>2nd Period</b></label>
      <select class="form-control" name="period2">
        <option disabled selected>Select</option>
        {{#each ../teachers}}
          <option value="{{_id}}|{{subject._id}}">{{Name}} - {{subject.sname}}</option>
        {{/each}}
      </select>
    </div>

    <!-- Period 3 -->
    <div class="col-md-12 mt-3">
      <label><b>3rd Period</b></label>
      <select class="form-control" name="period3">
        <option disabled selected>Select</option>
        {{#each ../teachers}}
          <option value="{{_id}}|{{subject._id}}">{{Name}} - {{subject.sname}}</option>
        {{/each}}
      </select>
    </div>

    <!-- Period 4 -->
    <div class="col-md-12 mt-3">
      <label><b>4th Period</b></label>
      <select class="form-control" name="period4">
        <option disabled selected>Select</option>
        {{#each ../teachers}}
          <option value="{{_id}}|{{subject._id}}">{{Name}} - {{subject.sname}}</option>
        {{/each}}
      </select>
    </div>

    <!-- Period 5 -->
    <div class="col-md-12 mt-3">
      <label><b>5th Period</b></label>
      <select class="form-control" name="period5">
        <option disabled selected>Select</option>
        {{#each ../teachers}}
          <option value="{{_id}}|{{subject._id}}">{{Name}} - {{subject.sname}}</option>
        {{/each}}
      </select>
    </div>

    <!-- Period 6 -->
    <div class="col-md-12 mt-3">
      <label><b>6th Period</b></label>
      <select class="form-control" name="period6">
        <option disabled selected>Select</option>
        {{#each ../teachers}}
          <option value="{{_id}}|{{subject._id}}">{{Name}} - {{subject.sname}}</option>
        {{/each}}
      </select>
    </div>

    {{!-- You can break the loop after first teacher because options will repeat --}}
  
{{/if}}
  {{/each}}
</div>


  <div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
    <button type="submit" class="btn btn-primary">Add</button>
  </div>
</form>

        </div>
    </div>
</div>