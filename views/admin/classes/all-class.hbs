<main id="main" class="main">

    <div class="pagetitle">
        <h1>Manage Class</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item">Class</li>
                <li class="breadcrumb-item active">All Classes</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-lg-12">

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">All Classes</h5>

                        <button type="button" class="btn btn-primary mb-4" data-toggle="modal"
                            data-target="#addClassModal">
                            + Add Class
                        </button>

                        <div class="table-responsive">
                            <!-- Table with stripped rows -->
                            <table class="table datatable">
                                <thead>
                                    <tr>
                                        <th>No.</th>
                                        <th>Class Name</th>
                                        <th>Department</th>
                                        <th>Department Code</th>
                                        <th>Status</th>
                                        <th>Manage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each cls}}
                                    <tr>
                                        <td>{{incremented @index}}</td>
                                        <td>{{this.name}}</td>
                                        <td>{{this.depname}}</td>
                                        <td>{{this.depcode}}</td>
                                        <td>Active</td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <form action="/admin/delete-class/{{this._id}}" method="POST">
                                                    <button type="submit" class="btn btn-danger btn-sm"
                                                        onclick="return confirm('Are You Sure to Delete {{this.name}} ?')"><i
                                                            class="bi bi-trash"></i></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                        <!-- End Table -->

                    </div>
                </div>

            </div>
        </div>
    </section>

</main><!-- End #main -->

<!-- Add Class Modal -->
<div class="modal fade" id="addClassModal" tabindex="-1" role="dialog" aria-labelledby="addClassModalTitle"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Class</h5>
            </div>
            <div class="modal-body">
                <form action="/admin/add-class" method="post">
                    <div class="col-md-12 mb-3">
                        <label for="className" class="form-label">Class Name (Eg: MCA_S1)</label>
                        <input type="text" class="form-control" name="name" id="className" required>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label for="departmentSelect" class="form-label">Select Department</label>
                        <select class="form-control" name="depId" id="departmentSelect" required>
                            <option value="">-- Select Department --</option>
                            {{#each deps}}
                            <option value="{{this._id}}">{{this.name}} ({{this.depcode}})</option>
                            {{/each}}
                        </select>
                    </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary">Add</button>
            </div>
            </form>
        </div>
    </div>
</div>

<!-- jQuery -->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<!-- Bootstrap JS -->
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
