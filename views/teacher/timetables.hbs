<main id="main" class="main">
    <div class="container">
        <div class="pagetitle">
            <h1>Timetable</h1>

        </div><!-- End Page Title -->

        <section class="section">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table border table-bordered">
                
       <thead class="table-dark">
      <tr>
        <th>Day</th>
        <th>Period 1</th>
        <th>Period 2</th>
        <th>Period 3</th>
        <th>Period 4</th>
        <th>Period 5</th>
        <th>Period 6</th>
      </tr>
    </thead>
    <tbody>
       {{#each timetable}}
        <tr>
            <td>{{_id}}</td>  {{!-- Day Name --}}
            
            {{!-- Loop through periods dynamically --}}
            {{#each (lookup @root.periodMap _id)}}
                <td>
                    {{#if this}}
                        {{this.class}}<br>{{this.subject}}
                    {{else}}
                        -
                    {{/if}}
                </td>
            {{/each}}
        </tr>
        {{/each}}
    </tbody>

