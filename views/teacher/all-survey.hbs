<div class="page-content-wrapper main-content">
    <div class="container-md">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mt-3 mb-3">Manage Survey</h4>
            <a href="/teacher/add-survey" class="btn btn-dark">+ Add Survey</a>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="w-100 table table-bordered" id="dataTable">
                        <thead>
                            <tr>
                                
                                 <th scope="col">No.</th>
                                 <th data-type="date" data-format="YYYY/DD/MM">Added Date</th>
                                <th scope="col">Title</th>
                                <th scope="col">Class</th>
                                <th scope="col">Subject</th>
                                <th scope="col">Action</th>
                            
                            </tr>
                        </thead>
                        <tbody>
                            {{#each materials}}
                            <tr>
                                <td>{{incremented @index}}</td>
                                
                                <th>{{formatDate this.createdAt}}</th>
                                <td>{{this.assessmentTitle}}</td>
                                <td>{{this.classname}}</td>
                                <td>{{this.subject}}</td>
                                

                              

                                </td>

                                <td>
                                    <div class="d-flex gap-2">
                                        <a href="/teacher/assessment-show/{{this._id}}"
                                            class="btn btn-dark btn-sm">view</a>
                                        <a href="/teacher/delete-survey/{{this._id}}" class="btn btn-danger btn-sm">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    function deleteMaterial(id, wname) {
        Swal.fire({
            title: `Are you sure you want to delete "${wname}"?`,
            text: '',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#33ff68',
            cancelButtonColor: '#d29eee',
            confirmButtonText: 'Yes!',
            cancelButtonText: 'No'
        }).then((result) => {
            if (result.isConfirmed) {
                // Redirect to the delete route if confirmed
                window.location.href = `/builder/delete-material/${id}`;
            }
        });
    }
</script>