<main class="main pt-5">

    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mt-3 mb-3">Manage Attendance</h4>
            {{!-- <a href="/teacher/classes" class="btn btn-dark">+ Add Attendance</a> --}}
        </div>
        <div class="card">
            <div class="card-body">
                <h2>Attendance for {{classname}} - Period {{period}} ({{selectedDate}})</h2>

{{#if error}}
<p style="color: red;">{{error}}</p>
{{else}}
    <h3>Present Students</h3>
    <ul>
        {{#each presentStudents}}
         <li>{{this.Fname}} {{this.Lname}}</li> 
        {{/each}}
    </ul>

    <h3>Absent Students</h3>
    <ul>
        {{#each absentStudents}}
        <li>{{this.Fname}} {{this.Lname}}</li>
        {{/each}}
    </ul>
{{/if}}

<a href="/teacher/attendance">Back</a>








           
                <!-- End Table with stripped rows -->
            </div>
        </div>
    </div>
    </div>
