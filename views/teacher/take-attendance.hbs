<main class="main pt-5">

    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mt-3 mb-3">Manage Attendance</h4>
            {{!-- <a href="/teacher/classes" class="btn btn-dark">+ Add Attendance</a> --}}
        </div>
        <div class="card">
            <div class="card-body">


                <h4 class="card-title">Take Attendance for {{cls}} - {{subject}} ({{period}}, {{day}})</h4>
<form action="/teacher/submit-attendance" method="POST">
    <input type="hidden" name="day" value="{{day}}">
    <input type="hidden" name="cls" value="{{cls}}">
    <input type="hidden" name="sem" value="{{extractSem cls}}">
    <input type="hidden" name="period" value="{{period}}">
    <input type="hidden" name="subject" value="{{subject}}">

     <label>Select Date:</label>
    <input type="date" name="selectedDate" required>

   <table class="table datatable">
        <thead>
            <tr>
                <th>Student Name</th>
                <th>Present</th>
            </tr>
        </thead>
        <tbody>
            {{#each students}}
            <tr>
                <td>{{this.Fname}} {{this.Lname}}</td>
                <td>
                   <input type="checkbox" name="present[]" value="{{this._id}}">
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <button type="submit">Submit Attendance</button>
</form>




           
                <!-- End Table with stripped rows -->
            </div>
        </div>
    </div>
    </div>


    <script>
        function deleteMaterial(id, wname) {
            Swal.fire({
                title: `Are you sure you want to delete "${wname}"?`,
                text: '',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#33ff68',
                cancelButtonColor: '#d29eee',
                confirmButtonText: 'Yes!',
                cancelButtonText: 'No'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Redirect to the delete route if confirmed
                    window.location.href = `/builder/delete-material/${id}`;
                }
            });
        }
    </script>