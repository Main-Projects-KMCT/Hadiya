<main class="main pt-5">

    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mt-3 mb-3">Manage Attendance</h4>
            {{!-- <a href="/teacher/classes" class="btn btn-dark">+ Add Attendance</a> --}}
        </div>
        <div class="card">
            <div class="card-body">
                 <h5 class="card-title">Choose Classes</h5>

                        <div class="table-responsive">
                            <!-- Table with stripped rows -->
                            <table class="table datatable">
                                 <thead>
        <tr>
            <th>Day</th>
            <th>Class</th>
            <th>Period</th>
            <th>Subject</th>
        </tr>
    </thead>
                                <tbody>
        {{#each periods}}
            <tr>
                <td rowspan="{{calculateRowspan this.classes}}">{{this.day}}</td>
                {{#each this.classes}}
                    <td rowspan="{{this.periods.length}}">{{this.class}}</td>
                    {{#each this.periods}}
                        <td>{{this.period}}</td>
                        <td><a href="/teacher/take-attendance/{{../../day}}/{{../class}}/{{this.period}}/{{this.subject}}"/> {{this.subject}}</a> </td>
                    </tr>
                    {{/each}}
                {{/each}}
        {{/each}}
    </tbody>
                            </table>
                        </div>
                <!-- End Table with stripped rows -->
            </div>
        </div>
    </div>
    </div>


    <script>
        function deleteMaterial(id, wname) {
            Swal.fire({
                title: `Are you sure you want to delete "${wname}"?`,
                text: '',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#33ff68',
                cancelButtonColor: '#d29eee',
                confirmButtonText: 'Yes!',
                cancelButtonText: 'No'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Redirect to the delete route if confirmed
                    window.location.href = `/builder/delete-material/${id}`;
                }
            });
        }
    </script>