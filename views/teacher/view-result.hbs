<h3>Exam: {{exam.no}} - {{exam.subject}}</h3>
<table class="table" id="datatable">
    <thead>
        <tr>
            <th>Student Name</th>
            <th>Mark</th>
            <th>Internal Mark</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        {{#each exam.results}}
        <tr>
            <td>{{this.name}}</td>
            <td>{{this.mark}}</td>
            <td>{{this.internal}}</td>
            <td>{{this.status}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>