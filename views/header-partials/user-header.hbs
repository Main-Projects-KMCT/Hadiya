<header id="header" class="header d-flex align-items-center fixed-top">
    <div class="container-fluid container-xl position-relative d-flex align-items-center justify-content-between">

        <a href="/" class="logo d-flex align-items-center">
            <!-- Uncomment the line below if you also wish to use an image logo -->
            <!-- <img src="assets/img/logo.png" alt=""> -->
            <h1 class="sitename">ET LAB</h1>
        </a>

        <nav id="navmenu" class="navmenu">
            <ul>
                <li><a href="/" class="active">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#services">Services</a></li>
                {{#if user}}
                <li class="dropdown active" style="border-radius: 20px;"><a href="#"><span>{{user.Fname}}</span> <i
                            class="bi bi-chevron-down toggle-dropdown"></i></a>
                    <ul>
                        <li><a href="/dashboard">My Dashboard</a></li>
                        <li><a href="/profile">My Profile</a></li>
                        <li><a href="/notifications">My Notifications</a></li>

                        <li><a href="/signout">Logout</a></li>

                    </ul>
                </li>
                {{else}}
                <li class="dropdown active" style="border-radius: 20px;"><a href="#"><span>Get Started</span> <i
                            class="bi bi-chevron-down toggle-dropdown"></i></a>
                    <ul>
                        <li><a href="/signin">Login as Student</a></li>

                        <li><a href="/teacher">Login as Teacher</a></li>

                    </ul>
                </li>
                {{/if}}
                <li><a href="#contact">Contact</a></li>

            </ul>
            <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
        </nav>

    </div>
</header>