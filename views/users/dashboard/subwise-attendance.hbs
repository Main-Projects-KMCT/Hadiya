<style>
    .header {
        background-color: #404356 !important;
    }
</style>

<main class="main pt-5">
    <div class="container">
        <br><br><br>
        <div class="pagetitle">
            <h1>YOUR ATTENDENCE</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard">DASHBOARD</a></li>
                    <li class="breadcrumb-item">ATTENDANCE</li>
                </ol>
            </nav>
        </div><!-- End Page Title -->
        

       <section id="services" class="services section">

            <div class="row">
                <div class="col-lg-12">
                    <a href="dashboard/attendance" class="btn btn-dark btn-sm">BACK</a>
                    <a href="/attendance/daywise?userId={{user._id}}&class=1&sem=1" class="btn btn-dark btn-sm">DAY BY</a>
                    <div class="card shadow mt-3">
                        <div class="card-body">
                            <h3>BY SUBJECT</h3>
                            <div class="table-responsive">
                                <table class="table datatable table-bordered border">
                                    <thead>
                                        <tr>
                                             <th>No.</th>
                                            <th>SUBJECT NAME</th>
                                            <th>ACTUAL/TOTAL</th>
                                             <th>PERCENTAGE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#each attendance}}
                                        <tr>
                                            <td>{{incremented @index}}</td>
                                            <td> <p class="mb-0"><b>Subject : </b> {{this.subject}}</p></td>
                                            <td> {{this.attendedclass}}/ {{this.totalClass}}</td>
                                            <td>
                                                {{this.percentage}} % 
                                            </td>

                                        </tr>
                                        {{/each}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </section>
    </div>
</main><!-- End #main -->