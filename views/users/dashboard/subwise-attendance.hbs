<style>
    .header {
        background-color: #404356 !important;
    }
</style>

<main class="main pt-5">
    <div class="container">
        <br><br><br>
        <div class="pagetitle">
            <h1>YOUR ATTENDENCE</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard">DASHBOARD</a></li>
                    <li class="breadcrumb-item">ATTENDANCE</li>
                </ol>
            </nav>
        </div><!-- End Page Title -->
        

       <section id="services" class="services section">

            <div class="row">
                <div class="col-lg-12">
                    <a href="/dashboard/attendance" class="btn btn-dark btn-sm">BACK</a>
                    <a href="/attendance/daywise?userId={{user._id}}&class={{user.classname}}&sem={{extractSem user.classname}}" class="btn btn-dark btn-sm">DAY BY</a>
                    <div class="mb-2 mt-2">
                        <label class="form-group"> Change semester</label>
                        <select id="semSelect" class="form-select form-group form-select-sm">
                        <option value="S1">Semester 1</option>
                        <option value="S2">Semester 2</option>
                         <option value="S3">Semester 3</option>
                          <option value="S4">Semester 4</option>
                    </select>
                    <button id="updateSemBtn" class="btn btn-primary btn-sm">show</button>
                    </div>
                    <div class="card shadow mt-3">
                        <div class="card-body">
                            <h3>BY SUBJECT ({{className}})</h3>
                            <div class="table-responsive">
                                <table class="table datatable table-bordered border">
                                    <thead>
                                        <tr>
                                             <th>No.</th>
                                            <th>SUBJECT NAME</th>
                                            <th>ACTUAL/TOTAL</th>
                                             <th>PERCENTAGE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#each attendance}}
                                        <tr>
                                            <td>{{incremented @index}}</td>
                                            <td> <p class="mb-0"><b>Subject : </b> {{this.subject}}</p></td>
                                            <td> {{this.attendedClass}}/ {{this.totalClass}}</td>
                                            <td>
                                                {{this.percentage}} % 
                                            </td>

                                        </tr>
                                        {{/each}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </section>
    </div>
</main><!-- End #main -->

<script>
document.getElementById("updateSemBtn").addEventListener("click", function() {
    const selectedSem = document.getElementById("semSelect").value; 
    const userId = "{{user._id}}";
    const baseClass = "{{user.classname}}".split("_")[0]; // Extract department (e.g., MCA)
    
    const newClass = `${baseClass}_${selectedSem}`; // Change class name (e.g., MCA_S1 → MCA_S2)
    
    const newUrl = `/attendance/subjectwise?userId=${userId}&class=${newClass}&sem=${selectedSem}`;
    window.location.href = newUrl;
});
</script>