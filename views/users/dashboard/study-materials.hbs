<style>
    .header {
        background-color: #404356 !important;
    }
</style>

<main class="main">
    <style>
        .accordion-button:not(.collapsed) {
            color: var(--bs-accordion-active-color);
            background-color: transparent !important;
            box-shadow: inset 0 calc(-1* var(--bs-accordion-border-width)) 0 var(--bs-accordion-border-color);
        }
    </style>
    <br><br><br><br>
    <div class="container">


        <section class="section">
            <div class="row">
                <div class="col-lg-12">
                    <h3><B>All Study Materials </B></h3> <br>

                    <div class="card p-3 shadow">
                        <div class="table-responsive">
                            <table class="table border table-bordered">
                               <thead>
                            <tr>
                                 <th scope="col">No.</th>
                                 <th data-type="date" data-format="YYYY/DD/MM">Added Date</th>
                                <th scope="col">Title</th>
                                <th scope="col">Class</th>
                                <th scope="col">Amount</th>
                                <th scope="col">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each fees}}
                            <tr>
                                <th scope="row">{{incremented @index}}</th>
                                <th>{{formatDate this.createdAt}}</th>
                                <td>{{this.Name}}</td>
                                <td>{{this.classname}}</td>
                                <td>{{this.Price}}</td>
                                <td>{{this.Description}}</td>
                            </tr>
                            {{/each}}
                        </tbody>
                            </table>
                        </div>
                    </div>








                </div>
            </div>
        </section>
    </div>
</main>