<style>
    .header {
        background-color: #404356 !important;
    }
</style>

<main class="main">
    <style>
        .accordion-button:not(.collapsed) {
            color: var(--bs-accordion-active-color);
            background-color: transparent !important;
            box-shadow: inset 0 calc(-1* var(--bs-accordion-border-width)) 0 var(--bs-accordion-border-color);
        }
    </style>
    <br><br><br><br>
    <div class="container">


        <section class="section">
            <div class="row">
                <div class="col-lg-12">
                    <h3><B>STUDY MATERIALS</B></h3> <br>

                    <div class="card p-3 shadow">
                        <div class="table-responsive">
                            <table class="table border table-bordered">
                               <table class="w-100 table table-bordered" id="dataTable">
                            <tr>
                                <th>NO.</th>
                                <th data-type="date" data-format="YYYY/DD/MM">DATE</th>
                                <th>CLASS</th>
                                 <th>SUBJECT</th>
                                <th>TITLE</TITLE></th>
                                <th>MODULE </th>
                               
                                <th>MATERIALS</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each materials}}
                            <tr>
                                <td>{{incremented @index}}</td>

                                <td>{{formatDate this.date}}</td>
                                 <td>{{this.classname}}</td>
                                  <td>{{this.subject}}</td>
                                <td>{{this.name}}</td>
                                <td>{{this.no}}</td>
                                <td>{{this.desc}}</td>
                                <td>
                                     {{#each (range 1 this.docCount)}}
        <a href="/images/materials/{{../_id}}-{{this}}.pdf" class="mt-2 btn btn-dark btn-sm">
            View Material - {{this}}
        </a>
        <br>
    {{/each}}

                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                        </div>
                    </div>








                </div>
            </div>
        </section>
    </div>
</main>