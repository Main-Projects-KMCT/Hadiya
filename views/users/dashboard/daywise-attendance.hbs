<style>
    .header {
        background-color: #404356 !important;
    }
</style>

<main class="main pt-5">
    <div class="container">
        <br><br><br>
      <div class="container section-title" fade-up>
            <h2>DAY WISE ATTENDANCE</h2>
        </div><!-- End Page Title -->

        
         <section id="services" class="services section">

            <div class="row">
                <div class="col-lg-12">
                    <a href="/dashboard/attendance" class="btn btn-dark btn-sm">Back</a>
                    <a href="/attendance/subjectwise?userId={{user._id}}&class={{user.classname}}&sem={{extractSem user.classname}}" class="btn btn-dark btn-sm">subjectwise</a>
                    <div class="mb-2 mt-2">
                        <label class="form-group"> Change semester</label>
                        <select id="semSelect" class="form-select form-group form-select-sm">
                        <option value="S1">Semester 1</option>
                        <option value="S2">Semester 2</option>
                         <option value="S3">Semester 3</option>
                          <option value="S4">Semester 4</option>
                    </select>
                    <button id="updateSemBtn" class="btn btn-primary btn-sm">show</button>
                    </div>
                    <div class="card shadow mt-3">
                        <div class="card-body">
                            <h3>Daywise Attendance ({{className}})</h3>
                            <div class="table-responsive">
                                <table class="table datatable table-bordered border">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                             <th>Attendance Status</th>
                                             <th>Action</th>
                                           

                                            {{!-- <th>Attended Students</th> --}}

                                            {{!-- <th>Manage</th> --}}
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#each attendance}}
                                        <tr>
                                            <td>{{formatDate this.date}}</td>
                                            <td>     {{#if this.present}} <p class="btn-success">Present</p>
                                    {{else}}
                                        <p class="btn-danger">Absent</p>
                                        {{/if}}</p></td>
                                        <td><button class="btn btn-primary btn-sm view-attendance"
                                    data-date="{{this.date}}"
                                    data-subjects='{{json this.subjects}}'
                                    data-present="{{this.present}}">
                                View
                            </button></td>
                                            
                                           

                                        </tr>
                                        {{/each}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </section>
        <!-- Bootstrap Modal -->
<div class="modal fade" id="attendanceModal" tabindex="-1" aria-labelledby="attendanceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="attendanceModalLabel">Attendance Details</h5>
                
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table>
                    <tbody>
                        <th class="bg-success p-2"> Present</th>
                         <th class="bg-danger p-2"> Absent</th>
                    </tbody>
                </table>
                <h4 id="modal-date"></h4>
                <ul id="subject-list" class="list-group"></ul>
            </div>
        </div>
    </div>
</div>
    </div>
</main><!-- End #main -->

<script>
document.getElementById("updateSemBtn").addEventListener("click", function() {
    const selectedSem = document.getElementById("semSelect").value; 
    const userId = "{{user._id}}";
    const baseClass = "{{user.classname}}".split("_")[0]; // Extract department (e.g., MCA)
    
    const newClass = `${baseClass}_${selectedSem}`; // Change class name (e.g., MCA_S1 → MCA_S2)
    
    const newUrl = `/attendance/daywise?userId=${userId}&class=${newClass}&sem=${selectedSem}`;
    window.location.href = newUrl;
});
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".view-attendance").forEach(button => {
        button.addEventListener("click", function () {
            const date = this.getAttribute("data-date");
            const subjects = JSON.parse(this.getAttribute("data-subjects"));

            // Set modal title
            document.getElementById("modal-date").innerText = `Attendance on ${date}`;

            // Populate subjects
            const subjectList = document.getElementById("subject-list");
            subjectList.innerHTML = "";

            subjects.forEach(sub => {
                const listItem = document.createElement("li");
                listItem.classList.add("list-group-item", "text-white");
                listItem.innerText = sub.subject;
                
                if (sub.present) {
                    listItem.classList.add("bg-success");
                } else {
                    listItem.classList.add("bg-danger");
                }

                subjectList.appendChild(listItem);
            });

            // Show modal
            const attendanceModal = new bootstrap.Modal(document.getElementById("attendanceModal"));
            attendanceModal.show();
        });
    });
});

</script>