<style>
    .header {
        background-color: black !important;
    }
</style>

<main class="main pt-5">
    <div class="container">
        <br><br><br>
        <div class="pagetitle">
            <h1>My Attendance</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item">Attendance</li>
                </ol>
            </nav>
        </div><!-- End Page Title -->

        
         <section id="services" class="services section">

            <div class="row">
                <div class="col-lg-12">
                    <a href="/dashboard/attendance" class="btn btn-dark btn-sm">Back</a>
                    <a href="/attendance/subjectwise?userId={{user._id}}&class=1&sem=1" class="btn btn-dark btn-sm">subjectwise</a>
                    <div class="card shadow mt-3">
                        <div class="card-body">
                            <h3>Daywise Attendance</h3>
                            <div class="table-responsive">
                                <table class="table datatable table-bordered border">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                             <th>Attendance Status</th>
                                             <th>Action</th>
                                           

                                            {{!-- <th>Attended Students</th> --}}

                                            {{!-- <th>Manage</th> --}}
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#each attendance}}
                                        <tr>
                                            <td>{{formatDate this.date}}</td>
                                            <td>     {{#if this.present}} <p class="btn-success">Present</p>
                                    {{else}}
                                        <p class="btn-danger">Absent</p>
                                        {{/if}}</p></td>
                                        <td><button class="btn btn-primary btn-sm view-attendance"
                                    data-date="{{this.date}}"
                                    data-subjects='{{json this.subjects}}'
                                    data-present="{{this.present}}">
                                View
                            </button></td>
                                            
                                           

                                        </tr>
                                        {{/each}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </section>
        <!-- Bootstrap Modal -->
<div class="modal fade" id="attendanceModal" tabindex="-1" aria-labelledby="attendanceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="attendanceModalLabel">Attendance Details</h5>
                
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table>
                    <tbody>
                        <th class="bg-success p-2"> Present</th>
                         <th class="bg-danger p-2"> Absent</th>
                    </tbody>
                </table>
                <h4 id="modal-date"></h4>
                <ul id="subject-list" class="list-group"></ul>
            </div>
        </div>
    </div>
</div>
    </div>
</main><!-- End #main -->

<script>
    document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".view-attendance").forEach(button => {
        button.addEventListener("click", function () {
            const date = this.getAttribute("data-date");
            const subjects = JSON.parse(this.getAttribute("data-subjects"));

            // Set modal title
            document.getElementById("modal-date").innerText = `Attendance on ${date}`;

            // Populate subjects
            const subjectList = document.getElementById("subject-list");
            subjectList.innerHTML = "";

            subjects.forEach(sub => {
                const listItem = document.createElement("li");
                listItem.classList.add("list-group-item", "text-white");
                listItem.innerText = sub.subject;
                
                if (sub.present) {
                    listItem.classList.add("bg-success");
                } else {
                    listItem.classList.add("bg-danger");
                }

                subjectList.appendChild(listItem);
            });

            // Show modal
            const attendanceModal = new bootstrap.Modal(document.getElementById("attendanceModal"));
            attendanceModal.show();
        });
    });
});

</script>