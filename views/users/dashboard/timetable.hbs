<style>
    .header {
        background-color: #404356 !important;
    }
</style>

<main class="main">
    <style>
        .accordion-button:not(.collapsed) {
            color: var(--bs-accordion-active-color);
            background-color: transparent !important;
            box-shadow: inset 0 calc(-1* var(--bs-accordion-border-width)) 0 var(--bs-accordion-border-color);
        }
    </style>
    <br><br><br><br>
    <div class="container">


        <section class="section">
            <div class="row">
                <div class="col-lg-12">
                    <h3><B>TIME TABLE</B></h3> <br>

                    <div class="card p-3 shadow">
                        <div class="table-responsive">
                            <table class="table border table-bordered">
                                <thead>
                                    <tr>
                                        <th>DAY</th>

                                        <th>HOUR 1</th>
                                        <th>HOUR 2</th>
                                        <th>HOUR 3</th>
                                        <th>HOUR 4</th>
                                        <th>HOUR 5</th>
                                        <th>HOUR 6</th>
                                    </tr>
                                </thead>
                                <tbody>
                                     {{#each timetables}}
        <tr>
            <td>{{this.day}}</td>
            {{#each this.periods}}
                <td>
                    {{#if subject}}
                        {{subject}} 
                    {{else}}
                        -
                    {{/if}}
                </td>
            {{/each}}
        </tr>
        {{/each}}
                                </tbody>
                            </table>
                        </div>
                    </div>








                </div>
            </div>
        </section>
    </div>
</main>