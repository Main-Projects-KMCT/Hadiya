<script>
    function showTab(tab) {
        document.querySelectorAll('.tabs button').forEach(btn => btn.classList.remove('active'));
        if (tab === 'subject') {
            document.querySelectorAll('.tabs button')[0].classList.add('active');
            document.getElementById('subjectTable').style.display = 'block';
            document.getElementById('dayTable').style.display = 'none';
        } else {
            document.querySelectorAll('.tabs button')[1].classList.add('active');
            document.getElementById('subjectTable').style.display = 'none';
            document.getElementById('dayTable').style.display = 'block';
        }
    }
</script>

