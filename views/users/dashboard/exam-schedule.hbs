<style>
    .header {
        background-color: #404356 !important;
    }
</style>

<main class="main">
    <style>
        .accordion-button:not(.collapsed) {
            color: var(--bs-accordion-active-color);
            background-color: transparent !important;
            box-shadow: inset 0 calc(-1* var(--bs-accordion-border-width)) 0 var(--bs-accordion-border-color);
        }
    </style>
    <br><br><br><br>
    <div class="container">


        <section class="section">
            <div class="row">
                <div class="col-lg-12">
                    <h3><B>ALL EXAM</B></h3> <br>

                    <div class="card p-3 shadow">
                        <div class="table-responsive">
                            <table class="table border table-bordered">
                               <thead>
                            <tr>
                                <th>No.</th>
                                <th data-type="date" data-format="YYYY/DD/MM">Added Date</th>
                                <th data-type="date" data-format="YYYY/DD/MM">Exam Date</th>
                                <th>Teacher</th>
                                 <th>Subject</th>

                                <th>Exam Details</th>

                            </tr>
                        </thead>
                        <tbody>
                            {{#each exams}}
                            <tr>
                                <td>{{incremented @index}}</td>
                                <td>{{formatDate this.createdAt}}</td>
                                <td>{{formatDate this.examdate}}</td>
                                <td>{{this.teacher}}</td>
                                <TD>{{this.subject}}</TD>
                                <td>{{this.no}} </td>


                            </tr>
                            {{/each}}
                        </tbody>
                            </table>
                        </div>
                    </div>








                </div>
            </div>
        </section>
    </div>
</main>