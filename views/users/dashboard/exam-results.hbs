<style>
    .header {
        background-color: #404356 !important;
    }
</style>

<main class="main">
    <style>
        .accordion-button:not(.collapsed) {
            color: var(--bs-accordion-active-color);
            background-color: transparent !important;
            box-shadow: inset 0 calc(-1* var(--bs-accordion-border-width)) 0 var(--bs-accordion-border-color);
        }
    </style>
    <br><br><br><br>
    <div class="container">


        <section class="section">
            <div class="row">
                <div class="col-lg-12">
                    <h3><B> EXAM RESULTS</B></h3> <br>

                    <div class="card p-3 shadow">
                        <div class="table-responsive">
                            <table class="table border table-bordered">
                               <thead>
                            <tr>
                                 <th scope="col">No.</th>
                                 <th data-type="date" data-format="YYYY/DD/MM">Publish Date</th>
                                  <th>Exam type</th>
                                  <th>subject</th>
                                  <th>classname</th>
                                  <th>Mark</th>
                                  <th>Internal Mark</th>
                                  <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each result}}
                            <tr>
                                <th scope="row">{{incremented @index}}</th>
                                <th>{{formatDate this.updatedAt}}</th>
                                <td>{{this.no}}</td>
                                <td>{{this.subject}}</td>
                                <td>{{this.classname}}</td>
                                <td>{{this.results.mark}}/{{this.results.fullmark}}</td>
                                 <td>{{this.results.internal}}</td>
                                  <td> <span class="{{#if (eq this.results.status 'Fail')}}text-danger{{else}}text-success{{/if}}">{{this.results.status}} </td>
                                


                            </tr>
                            {{/each}}
                        </tbody>
                            </table>
                        </div>
                    </div>








                </div>
            </div>
        </section>
    </div>
</main>