<style>
    html,
    body {
        background-color: rgb(243, 243, 243);
    }

    .about-img {
        max-width: 500px;
        height: auto;
        border-radius: 20px;
    }
</style>

<br><br>
<div class="container-md mt-5 p-5">
    <div class="d-flex gap-4 align-items-start">
        <!-- Image on the left -->
        <div class="">
            <img src="/images/img/workspace.jpg" alt="" class="about-img">
        </div>

        <!-- Content on the right -->
        <div class="p-2">
            <h2>Job Openings</h2>
            <table>
    <tr>
        <th>Title</th>
        <th>Company</th>
        <th>Location</th>
        <th>Apply</th>
    </tr>
    {{#each jobs}}
    <tr>
        <td>{{this.title}}</td>
        <td>{{this.company}}</td>
        <td>{{this.location}}</td>
        <td>
            <a href="/apply/{{this._id}}">Apply</a>
        </td>
    </tr>
    {{/each}}
</table>


        </div>
    </div>

    



</div>