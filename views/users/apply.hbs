<style>


    .about-img {
        max-width: 100%;
        height: 20% !important;
        border-radius: 20px;
    }
</style>
<style>
    .header {
        background-color: #404356 !important;
    }
</style>

<main class="main pt-5">
    <div class="container">
        <br><br><br>
        <div class="pagetitle">
            <h1>Job Apply</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Careers</a></li>
                    <li class="breadcrumb-item">Apply</li>
                </ol>
            </nav>
        </div><!-- End Page Title -->

       

           <div class="row">
    <div class="col-lg-12 col-md-12" >
        <div class="service-item position-relative">
            <div class="p-2">
                <h2>Apply for {{job.title}}</h2>

<form action="/apply/{{job._id}}" enctype="multipart/form-data" method="POST">
    <div class="form-group">
        <label>Full Name</label>
        <input type="text" name="fullName" class="form-control" required>
    </div>

    <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" class="form-control" required>
    </div>

    <div class="form-group">
        <label>Phone</label>
        <input type="tel" name="phone" class="form-control" required>
    </div>

    <div class="form-group">
        <label class="form-label" for="exampleInputText">Higher Qualification</label>
        <input type="text" name="qualification" class="form-control" required>
    </div>
    <div class="form-group">
        <label class="form-label" for="exampleInputText">Total Year of Experiance</label>
        <input type="number" name="experiance" class="form-control" required>
    </div>

    <div class="form-group">
        <label>Resume (PDF)</label>
        <input class="form-control" id="exampleInputText" name="File" type="file" accept="application/pdf" required>
    </div>

    <button type="submit" class="mt-2 btn btn-primary">Submit Application</button>
</form>

            </div> 
        </div>
    </div>
</div>

        </section>
    </div>
</main><!-- End #main -->



