<style>
    label {
        font-size: 13px;
        margin-bottom: 10px;
    }

    .header {
        background-color: black !important;
    }

    .login-wrapper {
        margin-top: 100px;
    }

    .profile-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 20px;
    }

    .profile-img {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #ddd;
    }
</style>
<!-- Login Wrapper Area -->
<div class="login-wrapper d-flex align-items-center justify-content-center">
    <div class="container-lg mb-4">
        <div class="d-flex gap-3">
            <a href="/" class="btn btn-sm btn-dark">
                <i class="bi bi-arrow-left-short"></i> Back
            </a>
            {{#if user}}
            <a href="/edit-profile/{{user._id}}" class="btn btn-sm btn-primary">
                <i class="bi bi-pen"></i> Edit Profile
            </a>
            {{/if}}
        </div>

        <div class="card shadow p-4 mt-3">
            <div class="register-form mt-4">
                <h4 class="mb-5 text-left">My Profile</h4>
                {{#if user}}
                <div class="profile-card">
                    <img src="{{user.profileImage}}" alt="Profile Image" class="profile-img">
                    <div>
                        <h5>{{user.Fname}} {{user.Lname}}</h5>
                        <p>{{user.Email}}</p>
                    </div>
                </div>
                <hr>
                <form action="#" method="">
                    <div class="row g-1">
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label>First Name</label>
                                <input class="form-control" type="text" name="Fname" value="{{user.Fname}}" readonly>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label>Last Name</label>
                                <input class="form-control" type="text" name="Lname" value="{{user.Lname}}" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Phone Number</label>
                        <input class="form-control" type="number" name="Phone" value="{{user.Phone}}" readonly>
                    </div>
                    <div class="form-group">
                        <label>Address</label>
                        <textarea class="form-control" name="Address" readonly>{{user.Address}}</textarea>
                    </div>
                    <div class="row g-1">
                        <div class="col-lg-7">
                            <div class="form-group">
                                <label>City</label>
                                <input class="form-control" type="text" name="District" value="{{user.District}}" readonly>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="form-group">
                                <label>Pincode</label>
                                <input class="form-control" type="number" name="Pincode" value="{{user.Pincode}}" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row g-1">
                        <div class="col-lg-7">
                            <div class="form-group">
                                <label>Department</label>
                                <input class="form-control" type="text" name="District" value="{{user.depcode}}" readonly>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="form-group">
                                <label>class</label>
                                <input class="form-control" type="text" name="Pincode" value="{{user.classname}}" readonly>
                            </div>
                        </div>
                    </div>
                </form>
                {{/if}}
            </div>
        </div>
    </div>
</div>
